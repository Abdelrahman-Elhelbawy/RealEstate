@model RealEstate.Application.DTOs.Property.PropertyDto

@{
    ViewData["Title"] = Model.Title;
    var images = ViewBag.Images as List<RealEstate.Application.DTOs.PropertyImage.PropertyImageListDto>;
    var agent = ViewBag.Agent as RealEstate.Application.DTOs.Agent.AgentDto;
    var primaryImage = images?.FirstOrDefault(i => i.IsPrimary) ?? images?.FirstOrDefault();
}

<div class="container py-5">
    <!-- Breadcrumb & Actions Bar -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb m-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Property" asp-action="Index">Properties</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
            </ol>
        </nav>
        <div class="d-flex gap-2">
            <button id="btn-share-property" class="btn btn-outline-custom btn-sm" type="button">
                <i class="bi bi-share me-1"></i> Share
            </button>
            <button class="btn btn-fav btn-sm border" data-property-id="@Model.Id" type="button">
                <i class="bi bi-heart me-1"></i> Favorite
            </button>
            <a href="#reportModal" data-bs-toggle="modal" class="btn btn-outline-danger btn-sm">
                <i class="bi bi-flag me-1"></i> Report Listing
            </a>
        </div>
    </div>

    <!-- Main Detail Header Card -->
    <div class="detail-header-card">
        <div class="row align-items-center g-3">
            <div class="col-lg-8">
                <div class="d-flex gap-2 mb-2">
                    <span class="badge bg-primary px-3 py-2">@Model.TransactionType</span>
                    <span class="badge bg-secondary px-3 py-2">@Model.PropertyType</span>
                    @if (Model.IsFeatured)
                    {
                        <span class="badge bg-warning text-dark px-3 py-2 fw-bold"><i class="bi bi-star-fill me-1"></i> Featured</span>
                    }
                </div>
                <h1 class="fw-extrabold text-dark m-0 fs-2">@Model.Title</h1>
                <p class="text-muted m-0 mt-1">
                    <i class="bi bi-geo-alt-fill text-primary me-1"></i>
                    @(string.IsNullOrWhiteSpace(Model.Address) ? Model.City : $"{Model.Address}, {Model.City}")
                </p>
            </div>
            <div class="col-lg-4 text-lg-end">
                <small class="text-muted text-uppercase fw-bold">Asking Price</small>
                <div class="fs-1 fw-extrabold text-primary">$@Model.Price.ToString("N0")</div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Main Column: Photo Gallery, Specs, Description -->
        <div class="col-lg-8">
            <!-- Database Image Gallery Viewer -->
            <div class="mb-4">
                @if (images != null && images.Any() && primaryImage != null)
                {
                    <img id="main-gallery-img" 
                         src="@primaryImage.ImageUrl" 
                         alt="@Model.Title" 
                         class="gallery-main-img" />

                    @if (images.Count > 1)
                    {
                        <div class="gallery-thumbs-grid">
                            @foreach (var img in images)
                            {
                                <div class="gallery-thumb-item @(img.Id == primaryImage.Id ? "active" : "")" data-img-src="@img.ImageUrl">
                                    <img src="@img.ImageUrl" alt="Property Image #@img.Id" />
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="p-5 text-center bg-white rounded-4 border shadow-sm my-2">
                        <div class="mb-3 text-muted">
                            <i class="bi bi-camera-fill" style="font-size: 3.5rem;"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-1">No Photos Uploaded</h5>
                        <p class="text-muted small m-0">There are currently no images uploaded in the database for this property (ID #@Model.Id).</p>
                    </div>
                }
            </div>

            <!-- Key Specifications Grid -->
            <div class="bg-white rounded-4 border p-4 mb-4 shadow-sm">
                <h4 class="fw-bold text-dark mb-3">Property Overview</h4>
                <div class="row g-3">
                    <div class="col-6 col-sm-4 col-md-3">
                        <div class="feature-spec-box">
                            <div class="feature-spec-icon"><i class="bi bi-door-open"></i></div>
                            <div class="feature-spec-val">@Model.Bedrooms</div>
                            <div class="feature-spec-lbl">Bedrooms</div>
                        </div>
                    </div>
                    <div class="col-6 col-sm-4 col-md-3">
                        <div class="feature-spec-box">
                            <div class="feature-spec-icon"><i class="bi bi-droplet"></i></div>
                            <div class="feature-spec-val">@Model.Bathrooms</div>
                            <div class="feature-spec-lbl">Bathrooms</div>
                        </div>
                    </div>
                    <div class="col-6 col-sm-4 col-md-3">
                        <div class="feature-spec-box">
                            <div class="feature-spec-icon"><i class="bi bi-aspect-ratio"></i></div>
                            <div class="feature-spec-val">@Model.Area m²</div>
                            <div class="feature-spec-lbl">Total Area</div>
                        </div>
                    </div>
                    <div class="col-6 col-sm-4 col-md-3">
                        <div class="feature-spec-box">
                            <div class="feature-spec-icon"><i class="bi bi-layers"></i></div>
                            <div class="feature-spec-val">@Model.Floor</div>
                            <div class="feature-spec-lbl">Floor Level</div>
                        </div>
                    </div>
                    <div class="col-6 col-sm-4 col-md-3">
                        <div class="feature-spec-box">
                            <div class="feature-spec-icon"><i class="bi bi-lamp"></i></div>
                            <div class="feature-spec-val">@(Model.Furnished ? "Yes" : "No")</div>
                            <div class="feature-spec-lbl">Furnished</div>
                        </div>
                    </div>
                    <div class="col-6 col-sm-4 col-md-3">
                        <div class="feature-spec-box">
                            <div class="feature-spec-icon"><i class="bi bi-eye"></i></div>
                            <div class="feature-spec-val">@Model.ViewsCount</div>
                            <div class="feature-spec-lbl">Page Views</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Description -->
            <div class="bg-white rounded-4 border p-4 mb-4 shadow-sm">
                <h4 class="fw-bold text-dark mb-3">Description</h4>
                <p class="text-muted lh-lg m-0">
                    @(string.IsNullOrWhiteSpace(Model.Description) ? "No detailed description has been provided for this listing yet. Please contact the listing agent using the form on the right for full property specifics and viewing schedules." : Model.Description)
                </p>
            </div>

            <!-- Location Placeholder -->
            <div class="bg-white rounded-4 border p-4 shadow-sm">
                <h4 class="fw-bold text-dark mb-3">Location & Neighborhood</h4>
                <div class="p-4 bg-light rounded-3 text-center border">
                    <i class="bi bi-map fs-1 text-primary"></i>
                    <h6 class="fw-bold mt-2">@Model.City, @Model.Address</h6>
                    <p class="text-muted small m-0">Coordinates: @Model.Latitude, @Model.Longitude</p>
                </div>
            </div>
        </div>

        <!-- Right Column: Agent Card & Contact Form -->
        <div class="col-lg-4">
            <div class="agent-contact-card">
                <h5 class="fw-bold text-dark mb-3">Listed By Agent</h5>
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="agent-avatar">
                        @(agent != null && !string.IsNullOrEmpty(agent.Name) ? agent.Name.Substring(0, 1).ToUpper() : "A")
                    </div>
                    <div>
                        <h6 class="fw-bold m-0 text-dark">@(agent != null ? agent.Name : "Assigned Agent")</h6>
                        <span class="badge bg-success-subtle text-success small">Agent ID #@Model.AgentId</span>
                        @if (agent != null && !string.IsNullOrEmpty(agent.Email))
                        {
                            <small class="text-muted d-block mt-1">@agent.Email</small>
                        }
                    </div>
                </div>

                <div class="d-flex flex-column gap-2 mb-4">
                    @if (agent != null && !string.IsNullOrEmpty(agent.WhatsApp))
                    {
                        <a href="https://wa.me/@agent.WhatsApp?text=Hi%20@agent.Name,%20I'm%20interested%20in%20property%20ID%20@Model.Id" target="_blank" class="btn btn-success fw-bold py-2">
                            <i class="bi bi-whatsapp me-2"></i> WhatsApp Agent (@agent.WhatsApp)
                        </a>
                    }
                    else
                    {
                        <a href="https://wa.me/201000000000?text=Hi,%20I'm%20interested%20in%20property%20ID%20@Model.Id" target="_blank" class="btn btn-success fw-bold py-2">
                            <i class="bi bi-whatsapp me-2"></i> WhatsApp Agent
                        </a>
                    }
                    <button class="btn btn-primary-custom py-2 fw-bold" data-bs-toggle="modal" data-bs-target="#messageModal">
                        <i class="bi bi-envelope-fill me-2"></i> Send Message
                    </button>
                </div>

                <hr />

                <!-- Embedded Quick Contact Form -->
                <h6 class="fw-bold text-dark mb-3">Inquire About This Property</h6>
                <form asp-controller="Message" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PropertyId" value="@Model.Id" />

                    <div class="mb-3">
                        <input type="text" name="SenderName" class="form-control form-control-sm" placeholder="Your Full Name" required />
                    </div>
                    <div class="mb-3">
                        <input type="tel" name="SenderPhone" class="form-control form-control-sm" placeholder="Your Phone Number" />
                    </div>
                    <div class="mb-3">
                        <input type="email" name="SenderEmail" class="form-control form-control-sm" placeholder="Your Email Address" />
                    </div>
                    <div class="mb-3">
                        <textarea name="Content" class="form-control form-control-sm" rows="3" placeholder="Write your message here..." required>Hi, I am interested in property #@Model.Id (@Model.Title). Please contact me.</textarea>
                    </div>

                    <button type="submit" class="btn btn-primary-custom w-100 fw-bold">
                        Submit Inquiry
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Send Message -->
<div class="modal fade" id="messageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-envelope me-1 text-primary"></i> Contact Agent</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Message" asp-action="Create" method="post">
                <div class="modal-body">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PropertyId" value="@Model.Id" />
                    <div class="mb-3">
                        <label class="form-label fw-bold">Full Name</label>
                        <input type="text" name="SenderName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Phone Number</label>
                        <input type="tel" name="SenderPhone" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Email</label>
                        <input type="email" name="SenderEmail" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Message</label>
                        <textarea name="Content" class="form-control" rows="4" required>Hi, I'd like more details regarding property #@Model.Id.</textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary-custom">Send Inquiry</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Report Property -->
<div class="modal fade" id="reportModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold text-danger"><i class="bi bi-flag me-1"></i> Report Property Listing</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="PropertyReport" asp-action="Create" method="post">
                <div class="modal-body">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PropertyId" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Reason for Report</label>
                        <select name="Reason" class="form-select" asp-items="Html.GetEnumSelectList<ReportReason>()" required></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Your Name</label>
                        <input type="text" name="ReporterName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Your Phone</label>
                        <input type="tel" name="ReporterPhone" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Description / Comments</label>
                        <textarea name="Description" class="form-control" rows="3" placeholder="Provide details about why you are reporting this listing..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Submit Report</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/property-details.js"></script>
}
