@model string

<div class="text-center py-5 my-4 bg-white rounded-3 border p-4 shadow-sm">
    <div class="mb-3 text-muted">
        <i class="bi bi-inbox fs-1" style="font-size: 3.5rem !important;"></i>
    </div>
    <h5 class="fw-bold text-dark mb-2">No Items Found</h5>
    <p class="text-muted mb-0">@(string.IsNullOrEmpty(Model) ? "There are currently no records available." : Model)</p>
</div>
