@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<aside id="admin-sidebar" class="admin-sidebar">
    <div class="admin-sidebar-header">
        <i class="bi bi-building-gear text-primary"></i>
        <span>Admin Panel</span>
    </div>

    <ul class="admin-nav">
        <li class="admin-nav-item">
            <a asp-controller="Admin" asp-action="Index" class="admin-nav-link @(currentController == "Admin" ? "active" : "")">
                <i class="bi bi-speedometer2"></i>
                <span>Dashboard</span>
            </a>
        </li>
        <li class="admin-nav-item">
            <a asp-controller="Property" asp-action="Index" class="admin-nav-link @(currentController == "Property" && currentAction != "Create" ? "active" : "")">
                <i class="bi bi-houses"></i>
                <span>Properties</span>
            </a>
        </li>
        <li class="admin-nav-item">
            <a asp-controller="Agent" asp-action="Index" class="admin-nav-link @(currentController == "Agent" ? "active" : "")">
                <i class="bi bi-people"></i>
                <span>Agents</span>
            </a>
        </li>
        <li class="admin-nav-item">
            <a asp-controller="Message" asp-action="Index" class="admin-nav-link @(currentController == "Message" ? "active" : "")">
                <i class="bi bi-envelope"></i>
                <span>Messages</span>
            </a>
        </li>
        <li class="admin-nav-item">
            <a asp-controller="PropertyImage" asp-action="Index" class="admin-nav-link @(currentController == "PropertyImage" ? "active" : "")">
                <i class="bi bi-images"></i>
                <span>Property Images</span>
            </a>
        </li>
        <li class="admin-nav-item">
            <a asp-controller="PropertyReport" asp-action="Index" class="admin-nav-link @(currentController == "PropertyReport" ? "active" : "")">
                <i class="bi bi-flag"></i>
                <span>Property Reports</span>
            </a>
        </li>
    </ul>

    <div class="p-3 mt-auto border-top border-secondary">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light w-100 btn-sm fw-bold">
            <i class="bi bi-arrow-left me-1"></i> Public Website
        </a>
    </div>
</aside>
