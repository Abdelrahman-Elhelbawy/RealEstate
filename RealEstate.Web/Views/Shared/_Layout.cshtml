<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " - PrimeEstate" : "PrimeEstate - Discover Luxury Properties")</title>
    <meta name="description" content="Discover premium properties for sale and rent. Search apartments, villas, houses, and commercial spaces with ease." />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS & Icons CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <!-- Modern Vibrant Editorial CSS Files -->
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/home.css" />
    <link rel="stylesheet" href="~/css/properties.css" />
    <link rel="stylesheet" href="~/css/property-details.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Navbar Header -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <span class="navbar-brand-dot"></span> PrimeEstate
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Property" asp-action="Index">Properties</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Favorites">
                                Favorites <span id="fav-count-badge" class="badge bg-danger rounded-pill ms-1" style="display:none;">0</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Message" asp-action="Create">Contact</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-custom">
                            <i class="bi bi-shield-lock me-1"></i> Admin Portal
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Container -->
    <main role="main">
        @await Html.PartialAsync("Partials/_AlertMessage")
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer-custom mt-auto">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="d-flex align-items-center gap-2">
                        <span class="navbar-brand-dot"></span> PrimeEstate
                    </h5>
                    <p class="text-secondary small">
                        Your trusted real estate partner offering verified properties, villas, apartments, and commercial spaces across top regions.
                    </p>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h5>Quick Links</h5>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-controller="Property" asp-action="Index">Properties</a></li>
                        <li><a asp-controller="Home" asp-action="Favorites">Saved Portfolio</a></li>
                        <li><a asp-controller="Message" asp-action="Create">Contact Agent</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h5>Categories</h5>
                    <ul class="footer-links">
                        <li><a asp-controller="Property" asp-action="Index">Apartments</a></li>
                        <li><a asp-controller="Property" asp-action="Index">Villas</a></li>
                        <li><a asp-controller="Property" asp-action="Index">Houses</a></li>
                        <li><a asp-controller="Property" asp-action="Index">Commercial Shops</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h5>Admin & Support</h5>
                    <ul class="footer-links">
                        <li><a asp-controller="Admin" asp-action="Index">Admin Dashboard</a></li>
                        <li><a asp-controller="Agent" asp-action="Index">Agent Directory</a></li>
                        <li><a asp-controller="PropertyReport" asp-action="Index">Report Management</a></li>
                    </ul>
                </div>
            </div>
            <div class="pt-3 border-top border-secondary text-center small text-secondary">
                &copy; @DateTime.Now.Year PrimeEstate Platform. All rights reserved.
            </div>
        </div>
    </footer>

    <!-- Core Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    <script src="~/js/favorites.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
