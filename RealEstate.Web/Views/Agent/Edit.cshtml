@model RealEstate.Application.DTOs.Agent.UpdateAgentDto

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit Agent";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="bg-white rounded-3 border p-4 shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                <h3 class="fw-bold text-dark m-0">Edit Agent Info</h3>
                <a asp-controller="Agent" asp-action="Index" class="btn btn-outline-custom btn-sm">Back to List</a>
            </div>

            <form asp-controller="Agent" asp-action="Edit" asp-route-id="@ViewContext.RouteData.Values["id"]" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-bold small">Agent Full Name</label>
                    <input asp-for="Name" class="form-control" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Phone" class="form-label fw-bold small">Phone Number</label>
                    <input asp-for="Phone" class="form-control" required />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="WhatsApp" class="form-label fw-bold small">WhatsApp Number</label>
                    <input asp-for="WhatsApp" class="form-control" />
                    <span asp-validation-for="WhatsApp" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label fw-bold small">Email Address</label>
                    <input asp-for="Email" type="email" class="form-control" required />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary-custom w-100 py-2 fw-bold">
                    <i class="bi bi-check-lg me-1"></i> Update Agent
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
