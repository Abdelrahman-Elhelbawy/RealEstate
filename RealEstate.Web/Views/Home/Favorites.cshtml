@model List<RealEstate.Application.DTOs.Property.PropertyListDto>

@{
    ViewData["Title"] = "Your Saved Favorites";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="fw-extrabold text-dark m-0 fs-2">Saved Properties</h1>
            <p class="text-muted mb-0">Manage and view your favorited real estate listings.</p>
        </div>
        <a asp-controller="Property" asp-action="Index" class="btn btn-outline-custom">
            <i class="bi bi-arrow-left me-1"></i> Browse More
        </a>
    </div>

    <!-- Container where cards are toggled based on localStorage -->
    <div id="favorites-cards-grid" class="row g-4">
        @foreach (var property in Model)
        {
            <div class="fav-property-card-wrapper" data-property-id="@property.Id" style="display:none;">
                @await Html.PartialAsync("Partials/_PropertyCard", property)
            </div>
        }
    </div>

    <!-- Empty state when no favorites exist -->
    <div id="no-favorites-empty" style="display:none;">
        @await Html.PartialAsync("Partials/_EmptyState", "You haven't saved any properties to your favorites yet. Click the heart icon on any property card to save it!")
    </div>
</div>
